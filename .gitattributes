# =============================================================================
# Interview Coach — .gitattributes
# Added in F1-T1 (2026-04-22). Force LF endings, mark binaries, stabilize diffs.
# =============================================================================

# Default: text with auto-detected EOL, normalized to LF
*           text=auto eol=lf

# Explicit text files
*.py        text diff=python
*.ts        text
*.tsx       text
*.js        text
*.jsx       text
*.json      text
*.md        text diff=markdown
*.yaml      text
*.yml       text
*.sql       text
*.rs        text
*.toml      text
*.sh        text eol=lf
*.bash      text eol=lf
*.css       text
*.html      text

# Binary files — never normalize
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.docx      binary
*.xlsx      binary
*.pptx      binary
*.zip       binary
*.tar       binary
*.gz        binary
*.mp3       binary
*.mp4       binary
*.wav       binary
*.ogg       binary

# Lockfiles — don't diff, don't normalize
*.lock      -text -diff
package-lock.json  -text -diff
pnpm-lock.yaml     -text -diff

# Generated / build output — exclude from GitHub language stats and reviews
tauri-app/dist/**          linguist-generated=true
python-core/venv/**        linguist-vendored=true
python-core/.venv/**       linguist-vendored=true
**/node_modules/**         linguist-vendored=true
