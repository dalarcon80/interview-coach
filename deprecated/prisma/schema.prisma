// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Phase model - F0 through F5
model Phase {
  id          String   @id @default(cuid())
  phaseId     String   @unique // F0, F1, F2, etc.
  name        String
  description String?
  status      String   @default("pending") // pending, in_progress, completed, blocked
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tasks       Task[]
  checkpoints Checkpoint[]
  
  @@map("phases")
}

// Task model - individual tasks within phases
model Task {
  id               String   @id @default(cuid())
  taskId           String   @unique // e.g., F0-T1, F1-T2
  phaseId          String
  title            String
  description      String?
  status           String   @default("pending") // pending, in_progress, done, blocked, failed
  allowedFiles     String?  // JSON array of file paths
  commandsToRun    String?  // JSON array of commands
  testsRequired    String?  // JSON array of test commands
  acceptanceCrit   String?  // JSON array of acceptance criteria
  stopRules        String?  // JSON array of stop rules
  dependencies     String?  // JSON array of task IDs
  result           String?  // JSON object with results
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  startedAt        DateTime?
  completedAt      DateTime?
  
  phase            Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  audits           Audit[]
  testResults      TestResult[]
  
  @@map("tasks")
}

// Checkpoint model - phase gate checkpoints
model Checkpoint {
  id               String   @id @default(cuid())
  phaseId          String
  name             String
  description      String?
  commands         String?  // JSON array of commands to run
  mustPassItems    String?  // JSON array of items that must pass
  status           String   @default("pending") // pending, passed, failed
  lastRunAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  phase            Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  
  @@map("checkpoints")
}

// Audit model - audit records for each task
model Audit {
  id                String   @id @default(cuid())
  taskId            String
  workedOnlyAllowed Boolean  @default(false)
  executedCommands  Boolean  @default(false)
  executedTests     Boolean  @default(false)
  completeReport    Boolean  @default(false)
  noTODOsCritical   Boolean  @default(false)
  noArchChanges     Boolean  @default(false)
  statusUpdated     Boolean  @default(false)
  decisionsUpdated  Boolean  @default(false)
  severity          String   @default("S3") // S0, S1, S2, S3
  notes             String?
  filesChanged      String?  // JSON array
  commandsOutput    String?  // JSON object
  testOutput        String?  // JSON object
  acceptanceResults String?  // JSON object with pass/fail
  blockers          String?  // JSON array
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  task              Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  @@map("audits")
}

// TestResult model - test execution results
model TestResult {
  id          String   @id @default(cuid())
  taskId      String
  testName    String
  command     String
  status      String   @default("pending") // pending, passed, failed, skipped
  output      String?
  duration    Int?     // in milliseconds
  runAt       DateTime?
  createdAt   DateTime @default(now())
  
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  @@map("test_results")
}

// SessionReport model - audit reports for sessions
model SessionReport {
  id                 String   @id @default(cuid())
  currentPhase       String
  currentTask        String?
  taskResult         String   @default("pending") // PASS, FAIL, BLOCKED
  testsRun           String?  // JSON array
  acceptanceVerified String?  // JSON array
  filesChanged       String?  // JSON array
  risksIntroduced    String?  // JSON array
  nextAllowedTask    String?
  statusFileUpdated  Boolean  @default(false)
  notes              String?
  createdAt          DateTime @default(now())
  
  @@map("session_reports")
}

// ProjectStatus model - overall project status (config/status.json equivalent)
model ProjectStatus {
  id              String   @id @default(cuid())
  currentPhase    String   @default("F0")
  currentTask     String?
  overallStatus   String   @default("not_started") // not_started, in_progress, completed, blocked
  lastSessionAt   DateTime?
  blockers        String?  // JSON array
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("project_status")
}

// TechnicalDecision model - config/decisions.md equivalent
model TechnicalDecision {
  id          String   @id @default(cuid())
  title       String
  description String?
  rationale   String?
  status      String   @default("active") // active, superseded, deprecated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("technical_decisions")
}

// ============================================
// INTERVIEW COACH MODELS
// ============================================

// CandidateProfile - Información del candidato
model CandidateProfile {
  id                String   @id @default(cuid())
  name              String
  email             String?
  phone             String?
  currentRole       String?  // Cargo actual
  currentCompany    String?  // Empresa actual
  yearsExperience   Int?
  skills            String?  // JSON array of skills
  achievements      String?  // JSON array of logros
  education         String?  // JSON array of educación
  languages         String?  // JSON array of idiomas
  certifications    String?  // JSON array of certificaciones
  linkedinUrl       String?
  portfolioUrl      String?
  summary           String?  // Resumen profesional
  rawResume         String?  // Texto completo del CV
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  interviewSessions InterviewSession[]
  
  @@map("candidate_profiles")
}

// CompanyInfo - Información de la empresa y cargo
model CompanyInfo {
  id                    String   @id @default(cuid())
  companyName           String
  industry              String?
  companySize           String?  // startup, small, medium, large, enterprise
  companyDescription    String?
  companyValues         String?  // JSON array of valores
  companyCulture        String?
  positionTitle         String   // Cargo al que aplica
  positionLevel         String?  // junior, mid, senior, lead, manager, director, c-level
  positionDepartment    String?
  positionDescription   String?
  positionRequirements  String?  // JSON array of requisitos
  salaryRange           String?
  location              String?
  workMode              String?  // remote, hybrid, onsite
  jobPostingUrl         String?
  notes                 String?  // Notas adicionales
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  interviewSessions     InterviewSession[]
  
  @@map("company_info")
}

// InterviewSession - Sesión de entrevista activa
model InterviewSession {
  id                  String   @id @default(cuid())
  candidateId         String?
  companyId           String?
  style               String   @default("mixed") // executive, commercial, technical, mixed
  status              String   @default("active") // active, paused, completed
  language            String   @default("es") // es, en, pt
  interviewType       String?  // technical, behavioral, case, mixed
  interviewerName     String?
  notes               String?
  startedAt           DateTime @default(now())
  endedAt             DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  candidate           CandidateProfile? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  company             CompanyInfo?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  questions           InterviewQuestion[]
  
  @@map("interview_sessions")
}

// InterviewQuestion - Preguntas y respuestas durante la entrevista
model InterviewQuestion {
  id              String   @id @default(cuid())
  sessionId       String
  questionText    String   // Texto de la pregunta detectada/transcrita
  questionType    String?  // behavioral, technical, situational, cultural_fit, salary, etc.
  detectedAt      DateTime @default(now())
  responseStyle   String   // executive, commercial, technical, mixed
  suggestedAnswer String?  // Respuesta sugerida por el coach
  userAnswer      String?  // Respuesta que el usuario dijo o planea decir
  feedback        String?  // Feedback sobre la respuesta
  confidenceScore Float?   // 0-1 score de confianza de detección
  language        String   @default("es")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  session         InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  @@map("interview_questions")
}
